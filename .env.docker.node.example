# NoctisPro opportunistic-node environment (e.g. a laptop joined over Tailscale).
# See DEPLOY_OPPORTUNISTIC_NODE.md. Copy to .env.docker.node and fill in:
#   cp .env.docker.node.example .env.docker.node

# ── Must match the cloud server's .env.docker EXACTLY ─────────────────────────
# SECRET_KEY signs sessions/CSRF tokens/password-reset links. If this doesn't match the
# cloud server's SECRET_KEY, a user whose request HAProxy happens to route to this node
# gets randomly logged out or hits CSRF failures — copy it byte-for-byte, don't regenerate.
SECRET_KEY=
DJANGO_SETTINGS_MODULE=noctis_pro.settings
DEBUG=False

# Same domain/host config as the cloud server's .env.docker.
DOMAIN_NAME=pacs.yourdomain.com
ALLOWED_HOSTS=pacs.yourdomain.com,localhost
CSRF_TRUSTED_ORIGINS=https://pacs.yourdomain.com

# Same Postgres credentials as the cloud server's .env.docker (DB_HOST/DB_PORT are set in
# docker-compose.node.yml itself, pointed at CLOUD_TAILSCALE_ADDR below — only user/pass/name
# need to match here).
DB_NAME=noctispro
DB_USER=noctispro
DB_PASSWORD=change-me

SERVE_MEDIA_FILES=False

# ── This node's own settings ───────────────────────────────────────────────────
# The cloud server's Tailscale IP or MagicDNS name (`tailscale ip -4` on the cloud server,
# or its device name from `tailscale status`).
CLOUD_TAILSCALE_ADDR=100.64.0.1

# redis://[:password@]<CLOUD_TAILSCALE_ADDR>:6379/0 — include the password segment only if
# you set REDIS_PASSWORD in the cloud's .env.docker (see the comment on the `redis` service
# in docker-compose.prod.yml). Without a password: redis://100.64.0.1:6379/0
REDIS_URL=redis://100.64.0.1:6379/0
CELERY_BROKER_URL=redis://100.64.0.1:6379/0
CELERY_RESULT_BACKEND=redis://100.64.0.1:6379/0

# Local mount point where scripts/setup-laptop-node.sh mounted the cloud's media export
# over NFS (see that script / DEPLOY_OPPORTUNISTIC_NODE.md). Must be the actual shared
# data, not a local directory — otherwise this node can't see studies uploaded elsewhere,
# and studies it receives are invisible everywhere else.
NODE_MEDIA_MOUNT=/mnt/noctis-media-nfs

# Worker counts — auto-detected from this machine's CPU/RAM if unset, same as the cloud side.
# CELERY_CONCURRENCY=2
# WEB_CONCURRENCY=2

# ── ML bone reconstruction (optional, same semantics as the cloud's .env.docker) ──────────
# BONE_ML_MODEL_PATH=
