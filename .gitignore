# Local tunnel URL written by helper scripts/systemd
.tunnel-url

# Local saved ngrok credentials/settings (do not commit)
.ngrok.env

# Docker env files (contain secrets) — .env.docker.node too, see DEPLOY_OPPORTUNISTIC_NODE.md
.env.docker
.env.docker.node
# scripts/start-stack.sh symlinks this to .env.docker so plain `docker compose` commands
# (no --env-file flag) still interpolate the real values instead of hardcoded defaults.
.env

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

logs/
media/
key
key.pub
